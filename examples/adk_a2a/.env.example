# Copy this file to .env and fill in your key. .env is ignored by git.
# Only `npm run demo` uses these variables: the tests and `npm run demo -- --deterministic`
# use a rule-based model instead of an LLM and need no key.

# Gemini API key (https://aistudio.google.com/apikey). The demo stops if it is missing.
GOOGLE_API_KEY=your-api-key-here

# Gemini model used by the Booking agent. Optional: defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
